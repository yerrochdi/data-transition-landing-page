// ============================================================
// NextMove AI — Data Model
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth & User
// ============================================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  firstName           String
  lastName            String
  avatarUrl           String?
  plan                Plan      @default(FREE)
  sprintExpiresAt     DateTime? // Active Sprint pass (one-time 30-day Pro access)
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastActiveAt        DateTime  @default(now())

  // Supabase auth link
  supabaseId          String?   @unique

  // Relations
  profile             UserProfile?
  onboarding          OnboardingResponse?
  journeyProgress     JourneyProgress[]
  taskSessions        TaskSession[]
  agentConversations  AgentConversation[]
  bookmarks           OpportunityBookmark[]
  analyticsSnapshots  AnalyticsSnapshot[]
  activities          Activity[]
  deliverables        Deliverable[]
  recommendations     RecommendedAction[]

  @@map("users")
}

enum Plan {
  FREE
  BOOST
  PREMIUM
  FOUNDING
  ENTERPRISE
}

// ============================================================
// User Profile (career info)
// ============================================================

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  currentRole      String?
  currentCompany   String?
  currentSector    String?
  targetRole       String?
  targetSector     String?
  experienceYears  Int?
  topSkills        String[] // array of skill names
  skillGaps        String[]
  careerScore      Int      @default(0)
  readinessScore   Int      @default(0)
  // Sprint 2 — readiness vivante : le score courant = baseline (déclaratif,
  // figé à l'onboarding) + bonus de progression prouvée (livrables validés,
  // phases complétées…). On stocke la baseline séparément pour que le
  // recalcul soit idempotent (pas de double comptage du bonus).
  readinessBaseline Int     @default(0)
  confidenceLevel  Int      @default(5) // 1-10

  // Career goal — 3 imposed dimensions (V1 Sprint 1)
  vertical            Vertical?            // FINANCE | TECH (priorité commerciale V1)
  transitionType      TransitionType?      // PIVOT | UPSKILL | INTERNAL_EVOLUTION
  horizon             Horizon?             // THREE_MONTHS | SIX_MONTHS | TWELVE_MONTHS
  successIndicator    SuccessIndicator?    // NEW_JOB | DATA_PROJECTS | SALARY_INCREASE

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum Vertical {
  FINANCE
  TECH
  OTHER
}

enum TransitionType {
  PIVOT
  UPSKILL
  INTERNAL_EVOLUTION
}

enum Horizon {
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

enum SuccessIndicator {
  NEW_JOB
  DATA_PROJECTS
  SALARY_INCREASE
}

// ============================================================
// Onboarding
// ============================================================

model OnboardingResponse {
  id               String   @id @default(uuid())
  userId           String   @unique
  situation        String?
  currentRole      String?
  currentSector    String?
  experienceYears  Int?
  targetRole       String?
  targetSector     String?
  topSkills        String[]
  skillGaps        String[]
  skillLevels      Json?    // [{name, level}]
  blockers         String[]
  confidenceLevel  Int?
  shortTermGoal    String?
  longTermGoal     String?
  preferredPace    Pace     @default(MODERATE)
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // New enriched fields
  educationLevel       String?
  certifications       String[]
  hasDataTraining      Boolean  @default(false)
  technicalAppetite    String?  // "no-code" | "low-code" | "code" | "flexible"
  motivation           String?  // "attracted" | "fleeing" | "both"
  keyAchievements      String?  @db.Text
  dreamScenario        String?  @db.Text
  availableHoursPerWeek Int?
  trainingBudget       String?  // "none" | "low" | "medium" | "high"
  location             String?
  remotePreference     String?  // "remote" | "hybrid" | "onsite" | "flexible"
  learningStyle        String[]
  priorities           String[] // ordered

  // AI-generated summary
  aiSummary        String?  @db.Text
  aiRecommendation String?  @db.Text

  // Sprint 2b — matériel personnel de l'onboarding, persisté pour que le
  // coach puisse s'y référer (expérience personnalisée) et pour les
  // futurs bilans v2. Avant : perdu après la génération du bilan.
  // ikigai : {passion:{userText,aiInsight}, forces:{...}, market:{...},
  //           alignment:{salaryExpectation,nonNegotiables,aiInsight}}
  ikigai            Json?
  // linkedinAnalysis : {synthesis, deduced_specialty, real_skills_deduced,
  //                     hidden_patterns, transition_angle, ...}
  linkedinAnalysis  Json?

  // Public sharing of the bilan — opt-in by the user from the dashboard.
  // Same pattern as deliverables (shareableSlug + isPublic).
  bilanIsPublic        Boolean @default(false)
  bilanShareableSlug   String? @unique

  // Career OS enrichment — optional modules unlocked after the first
  // bilan to push the product toward a long-term Career OS rather than
  // a one-shot transition tool. Each field corresponds to a mini-flow
  // the user can complete later for a richer bilan v2/v3.

  // 3 key inflections of past career — what moves they made, why,
  // what they learned. Stored as JSON [{year, from, to, why, lesson}].
  careerInflections     Json?
  careerInflectionsAt   DateTime?

  // Long-term vision: 5y/10y projection, values, non-negotiables.
  // Stored as JSON {fiveYears, tenYears, idealLife, dealbreakers}.
  longTermVision        Json?
  longTermVisionAt      DateTime?

  // Anchors and breakpoints: geo constraints, sector exclusions,
  // burnout triggers the user has identified.
  // Stored as JSON {geoAnchors, sectorExclusions, burnoutTriggers}.
  careerAnchors         Json?
  careerAnchorsAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_responses")
}

enum Pace {
  RELAXED
  MODERATE
  INTENSIVE
}

// ============================================================
// Journey (Parcours)
// ============================================================

model JourneyPhase {
  id          String      @id @default(uuid())
  slug        String      @unique // diagnostic, vision, positionnement, execution, acceleration
  number      String      // "01", "02", etc.
  title       String
  description String
  order       Int
  createdAt   DateTime    @default(now())

  modules     JourneyModule[]
  tasks       JourneyTask[]
  progress    JourneyProgress[]

  @@map("journey_phases")
}

model JourneyModule {
  id          String   @id @default(uuid())
  phaseId     String
  icon        String
  title       String
  subtitle    String
  order       Int
  createdAt   DateTime @default(now())

  phase JourneyPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@map("journey_modules")
}

model JourneyTask {
  id          String   @id @default(uuid())
  phaseId     String
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now())

  phase    JourneyPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  progress JourneyTaskProgress[]
  sessions TaskSession[]

  @@map("journey_tasks")
}

model JourneyProgress {
  id        String      @id @default(uuid())
  userId    String
  phaseId   String
  status    PhaseStatus @default(LOCKED)
  progress  Int         @default(0) // 0-100
  startedAt DateTime?
  completedAt DateTime?
  updatedAt DateTime    @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase JourneyPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  tasks JourneyTaskProgress[]

  @@unique([userId, phaseId])
  @@map("journey_progress")
}

enum PhaseStatus {
  LOCKED
  ACTIVE
  COMPLETED
}

model JourneyTaskProgress {
  id                String     @id @default(uuid())
  journeyProgressId String
  taskId            String
  status            TaskStatus @default(LOCKED)
  progress          Int        @default(0) // 0-100
  completedAt       DateTime?
  updatedAt         DateTime   @updatedAt

  journeyProgress JourneyProgress @relation(fields: [journeyProgressId], references: [id], onDelete: Cascade)
  task            JourneyTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([journeyProgressId, taskId])
  @@map("journey_task_progress")
}

// ============================================================
// AI-Driven Task Sessions
// ============================================================

model TaskSession {
  id                String        @id @default(uuid())
  userId            String
  taskId            String

  status            SessionStatus @default(LESSON)
  lessonContent     String?       @db.Text
  lessonCompletedAt DateTime?

  quizQuestions     Json?         // [{question, options, correctIndex, explanation}]
  quizAnswers       Json?         // [{questionIndex, selectedIndex, correct}]
  quizScore         Int?
  quizCompletedAt   DateTime?

  feedbackContent   String?       @db.Text

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  task JourneyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@map("task_sessions")
}

enum SessionStatus {
  LESSON
  QUIZ
  FEEDBACK
  COMPLETED
}

enum TaskStatus {
  LOCKED
  IN_PROGRESS
  DONE
}

// ============================================================
// AI Agents
// ============================================================

model AgentDefinition {
  id           String   @id @default(uuid())
  slug         String   @unique // career-coach, strategist, etc.
  name         String
  role         String
  description  String   @db.Text
  icon         String
  color        String
  capabilities Json     // [{id, label, description}]
  quickActions Json     // [{id, label, icon}]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  conversations AgentConversation[]

  @@map("agent_definitions")
}

model AgentConversation {
  id        String   @id @default(uuid())
  userId    String
  agentId   String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    AgentDefinition   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@map("agent_conversations")
}

model AgentMessage {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole // USER or AGENT
  content        String      @db.Text
  messageType    MessageType @default(CHAT)
  metadata       Json?       // extra data (action results, sources, etc.)
  createdAt      DateTime    @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}

enum MessageRole {
  USER
  AGENT
}

enum MessageType {
  CHAT
  INSIGHT
  SUGGESTION
  ACTION
  SUMMARY
}

// ============================================================
// Opportunities
// ============================================================

model Opportunity {
  id          String          @id @default(uuid())
  title       String
  company     String
  location    String
  type        OpportunityType
  salary      String?
  tags        String[]
  description String          @db.Text
  remote      Boolean         @default(false)
  sourceUrl   String?
  postedAt    DateTime
  isActive    Boolean         @default(true)

  // Real-job data (Sprint 2 — France Travail / scraping)
  source         OpportunitySource @default(MANUAL) // FRANCE_TRAVAIL | LINKEDIN_SCRAPE | ...
  externalId     String?           @unique           // Job ID from the source, used for upsert
  contractType   String?                             // CDI, CDD, MIS (intérim), STG...
  experienceText String?                             // "5 ans d'expérience exigée"
  romeCode       String?                             // ROME job code (M1801, M1802, ...)
  skills         String[]                            // Extracted by IA from description

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookmarks OpportunityBookmark[]
  matches   OpportunityMatch[]

  @@index([source, isActive])
  @@index([postedAt])
  @@map("opportunities")
}

enum OpportunitySource {
  MANUAL
  FRANCE_TRAVAIL
  LINKEDIN_SCRAPE
  WTTJ_SCRAPE
}

enum OpportunityType {
  JOB
  FREELANCE
  TRANSITION
  FORMATION
}

model OpportunityMatch {
  id              String   @id @default(uuid())
  opportunityId   String
  userId          String
  matchScore      Int      // 0-100
  aiReason        String   @db.Text
  gapExplanation  String?  @db.Text // skills missing, extracted by IA
  matchedSkills   String[] // skills from user that matched the offer
  missingSkills   String[] // skills from offer that user lacks
  lastComputedAt  DateTime @default(now())
  createdAt       DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([userId, matchScore])
  @@map("opportunity_matches")
}

model OpportunityBookmark {
  id            String   @id @default(uuid())
  userId        String
  opportunityId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@map("opportunity_bookmarks")
}

// ============================================================
// Analytics & Tracking
// ============================================================

model AnalyticsSnapshot {
  id                 String   @id @default(uuid())
  userId             String
  careerScore        Int
  readinessScore     Int
  overallProgress    Int
  completedPhases    Int
  totalTasksCompleted Int
  streakDays         Int
  skillProgress      Json     // [{name, current, target, category}]
  snapshotDate       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics_snapshots")
}

model Activity {
  id          String       @id @default(uuid())
  userId      String
  type        ActivityType
  title       String
  description String?
  icon        String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

enum ActivityType {
  AGENT_INTERACTION
  TASK_COMPLETED
  PHASE_COMPLETED
  OPPORTUNITY_VIEWED
  OPPORTUNITY_BOOKMARKED
  MILESTONE
  ONBOARDING_STEP
  // Sprint 2 — journal d'événements de carrière (système nerveux).
  // Chaque action significative devient un événement typé qui alimente
  // la readiness vivante, le Point du Lundi et (plus tard) le carnet
  // d'impact + le dossier d'entretien annuel.
  DELIVERABLE_VALIDATED
  IMPACT_LOGGED
  COMMITMENT_MADE
  WIN_DECLARED
  CHECKIN_ANSWERED
}

// ============================================================
// Resources
// ============================================================

model Resource {
  id          String       @id @default(uuid())
  title       String
  description String       @db.Text
  type        ResourceType
  category    String
  imageUrl    String?
  readTime    String?
  author      String?
  url         String
  isNew       Boolean      @default(true)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("resources")
}

enum ResourceType {
  ARTICLE
  GUIDE
  VIDEO
  TEMPLATE
  CASE_STUDY
}

model FoundingMemberApplication {
  id              String                          @id @default(uuid())
  name            String
  email           String
  linkedinUrl     String
  currentRole     String
  currentCompany  String
  situation       String                          @db.Text
  motivation      String                          @db.Text
  status          FoundingMemberApplicationStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewerNote    String?                         @db.Text
  activationToken String?                         @unique
  activatedAt     DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("founding_member_applications")
}

enum FoundingMemberApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ============================================================
// Billing — Stripe webhook idempotency
// ============================================================
// Stripe can replay the same event (timeouts, retries). We record
// every event id we've fully processed so a replay is a no-op instead
// of double-activating a plan or sending a duplicate email.

model ProcessedStripeEvent {
  id          String   @id // the Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())

  @@map("processed_stripe_events")
}

// ============================================================
// Deliverables (Sprint 3 — Livrables concrets / Portfolio)
// ============================================================

model DeliverableBrief {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  shortDescription    String   @db.Text  // 1-2 lines for catalogue card
  fullBrief           String   @db.Text  // markdown, full instructions
  sector              String   // "finance" | "tech" | "generic"
  skillCategory       String   // "data-viz" | "sql" | "ai-usecase" | "analysis" | "ml"
  difficulty          Int      // 1-5
  estimatedDays       Int      // 3-7
  templateUrl         String?  // Notion / GitHub / Figma template link
  tools               String[] // ["Power BI", "Python", "Notion", ...]
  evaluationCriteria  String   @db.Text  // markdown, what the IA reviewer looks for
  suggestedAtPhase    Int?     // 1-5, optional hint to Copilot
  // When true, the brief can be pre-drafted by the IA from the user's
  // onboarding profile (CV, 1-pager use case, LinkedIn summary). Pure
  // technical briefs (RAG, dashboard) leave this false because the user
  // must produce real artefacts.
  useFromProfile      Boolean  @default(false)
  // How the user submits this deliverable. TEXT_ONLY = the deliverable IS
  // the text content (CV, 1-pager). LINK_REQUIRED = the user must paste a
  // link to an external artefact (Notion, GitHub, Looker Studio).
  submissionMode      SubmissionMode @default(LINK_REQUIRED)
  isPublished         Boolean  @default(true)
  isPremium           Boolean  @default(false) // requires Pro/Sprint
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  deliverables Deliverable[]

  @@index([sector, isPublished])
  @@map("deliverable_briefs")
}

model Deliverable {
  id            String              @id @default(uuid())
  userId        String
  briefId       String
  status        DeliverableStatus   @default(DRAFT)

  // Submission
  content       String?             @db.Text  // markdown editor content
  fileUrl       String?                       // Vercel Blob URL for attached file
  externalUrl   String?                       // link to Notion / GitHub / Figma

  // AI review
  aiReview      Json?               // {score:0-100, strengths:[3], improvements:[3], suggestion:string}
  aiReviewAt    DateTime?

  // Portfolio sharing
  isPublic      Boolean             @default(false)
  shareableSlug String?             @unique

  startedAt     DateTime            @default(now())
  submittedAt   DateTime?
  validatedAt   DateTime?
  updatedAt     DateTime            @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brief DeliverableBrief @relation(fields: [briefId], references: [id], onDelete: Restrict)

  @@unique([userId, briefId])
  @@index([userId, status])
  @@map("deliverables")
}

enum DeliverableStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  VALIDATED
}

enum SubmissionMode {
  TEXT_ONLY      // CV, 1-pager use case — content text is the deliverable
  LINK_REQUIRED  // RAG, dashboard, analyse — need a link to external artefact
}

// ============================================================
// Orchestrator — what should the user do next?
// ============================================================
// One row per user that captures the *current* recommended action.
// We don't keep a long history here — the orchestrator recomputes on
// demand when the user state changes. The row is upserted, so each user
// has at most one active recommendation at a time (decision 1B: single
// next-best-action, not a list of 3).

model RecommendedAction {
  id          String   @id @default(uuid())
  userId      String   @unique
  // The action template the orchestrator picked. The template defines
  // the title, copy and target route — see lib/orchestrator/templates.ts.
  templateKey ActionTemplate
  // Free-form metadata the template needs to render (e.g. briefSlug,
  // phaseSlug). Schema depends on the template key.
  metadata    Json?
  status      ActionStatus @default(ACTIVE)
  generatedAt DateTime @default(now())
  completedAt DateTime?
  // Computed at the same time as the action: the user's readiness score
  // snapshot. We surface it in the UI for "you went from 30% to 45%".
  readinessSnapshot Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("recommended_actions")
}

enum ActionTemplate {
  COMPLETE_ONBOARDING
  RUN_DIAGNOSTIC
  FIRST_QUICK_DELIVERABLE
  ADVANCE_PHASE_1
  EXPLORE_OPPORTUNITIES
  AMBITIOUS_DELIVERABLE
  ADVANCE_LATER_PHASE
  // When the next logical action would be a new deliverable but the
  // user has reached their monthly quota — push them toward upgrade.
  UPGRADE_FOR_MORE
  // Sentinel when nothing is left and the user is fully active
  KEEP_MOMENTUM
}

enum ActionStatus {
  ACTIVE
  COMPLETED
  SKIPPED
}
